+	/*
+	 * A workqueue thread is re-armed by jumping back into `_start_wqthread`. On XNU the kernel
+	 * hands the thread a fresh stack pointer every time; here the jump would otherwise reuse the
+	 * stack pointer of the previous invocation, so every reuse would pile another set of frames
+	 * onto the thread's stack until it overflows.
+	 *
+	 * That is exactly what used to kill the QuartzCore renderer: the workqueue stack is only
+	 * 8 MB, and after a few hundred reuses the accumulated frames ran into the guard page, which
+	 * surfaced as a SIGSEGV inside `___chkstk_darwin` (fault address == stack bottom - 8).
+	 *
+	 * The thread's stack is allocated by the loader right below the thread structure, so the
+	 * thread structure itself (`self`) marks the top of the stack. We therefore always re-arm
+	 * the thread with the very same stack pointer: 256 bytes below the top of the stack, 16-byte
+	 * aligned (which is what `_start_wqthread` expects, since it aligns the stack itself before
+	 * calling into libpthread).
+	 *
+	 * The same value is used for the first entry and for every reuse, so the thread always sees
+	 * exactly the same stack layout.
+	 */
 #if __x86_64__
+	void* rearm_rsp = (void*)(((uintptr_t)self & ~(uintptr_t)15) - 256);
+
 	__asm__ __volatile__ (
+		// Re-arm the thread with a clean stack pointer.
+		"movq %[rearm_rsp], %%rsp\n\t"
 		// `_start_wqthread` does not expect the stack to be aligned (using the 
 		// call instruction will add the return address to the stack, causing 
 		// it to be aligned).
@@ -217,9 +267,13 @@ void wqueue_entry_point_asm_jump(void* self, int thread_port, void* stackaddr,
 		::
 		// Arguments follow the usual x86_64 calling conventions.
 		"r"(arg1),"r"(arg2),"r"(arg3),"r"(arg4),"r"(arg5),"r"(arg6),
+		[rearm_rsp] "r"(rearm_rsp),
 		[wqueue_entry_point] "r"(wqueue_entry_point)
+		: "memory"
 	);
 #elif __i386__
+	// TODO: the 32-bit port doesn't have enough registers to re-arm the stack pointer
+	// without spilling, so it keeps the old (leaky) behaviour. macOS 26 is 64-bit only.
 	__asm__ __volatile__ (
 		// `_start_wqthread` does not expect the stack to be aligned.
 		"jmpl *%[wqueue_entry_point]\n"
@@ -229,6 +283,7 @@ void wqueue_entry_point_asm_jump(void* self, int thread_port, void* stackaddr,
 		// the arguments are stored in the registers.
