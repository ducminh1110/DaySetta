 	xpc_connection_resume(membership_service_listener);
 
+	libinfo_service_queue = dispatch_queue_create(ODD_LIBINFO_SERVICE_NAME, DISPATCH_QUEUE_CONCURRENT);
+	if (!libinfo_service_queue) {
+		abort();
+	}
+
+	libinfo_service_listener = xpc_connection_create_mach_service(ODD_LIBINFO_SERVICE_NAME, libinfo_service_queue, XPC_CONNECTION_MACH_SERVICE_LISTENER);
+	if (!libinfo_service_listener) {
+		abort();
+	}
+
+	xpc_connection_set_event_handler(libinfo_service_listener, ^(xpc_object_t object) {
+		xpc_type_t type = xpc_get_type(object);
+
+		if (type == XPC_TYPE_CONNECTION) {
+			handle_new_libinfo_connection(object);
+		} else if (type == XPC_TYPE_ERROR) {
+			general_log_error("libinfo service listener received XPC error: %@", object);
+		} else {
+			general_log_error("unknown XPC object received on libinfo listener: %@", object);
+		}
+	});
+
+	xpc_connection_resume(libinfo_service_listener);
+
 	dispatch_main();
 	return 0;
 };
