--- a/src/NSUserDefaults.m
+++ b/src/NSUserDefaults.m
@@ -476,8 +476,12 @@ static void initQueues() {
         [defaults removeObjectForKey: key];
     }
 
-    [defaults registerDefaults: domain];
+    // registerDefaults: only fills the volatile registration domain, so nothing would reach disk.
+    for (id key in domain) {
+        [defaults setObject: [domain objectForKey: key] forKey: key];
+    }
     [defaults synchronize];
+    [defaults release];
 
     // Post a notification on self.
     [[NSNotificationCenter defaultCenter] postNotificationName:NSUserDefaultsDidChangeNotification object:self userInfo:nil];
