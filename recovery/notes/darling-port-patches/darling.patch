diff --git a/tools/sync-xnu-sdk-headers.py b/tools/sync-xnu-sdk-headers.py
new file mode 100644
index 000000000..730796fdc
--- /dev/null
+++ b/tools/sync-xnu-sdk-headers.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Sync Darling's SDK header symlinks with the checked-out xnu.
+
+Darling's SDK (Developer/.../MacOSX.sdk/usr/include) links each xnu header by hand. After an xnu
+update, headers that were added upstream have no link and headers that were removed leave dangling
+ones. For every SDK directory whose links point into one xnu directory, this adds links for headers
+present in that xnu directory but absent from the SDK, and removes dangling links into xnu.
+
+Usage: tools/sync-xnu-sdk-headers.py [--dry-run] <old-xnu-ref>
+  old-xnu-ref: the xnu commit the SDK was built against; only headers added since then are linked,
+  so headers Darling deliberately left out stay out.
+"""
+import collections, os, subprocess, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SDK = os.path.join(ROOT, 'Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include')
+XNU = os.path.join(ROOT, 'src/external/xnu')
+
+def main():
+    dry = '--dry-run' in sys.argv
+    old_ref = [a for a in sys.argv[1:] if not a.startswith('--')][0]
+    old = set(subprocess.run(['git', '-C', XNU, 'ls-tree', '-r', '--name-only', old_ref],
+                             capture_output=True, text=True, check=True).stdout.split())
+    targets = collections.defaultdict(collections.Counter)  # sdk dir -> xnu dir -> link count
+    added = removed = 0
+    for dp, dns, fns in os.walk(SDK):
+        for f in fns + dns:
+            p = os.path.join(dp, f)
+            if not os.path.islink(p):
+                continue
+            real = os.path.normpath(os.path.join(dp, os.readlink(p)))
+            if not real.startswith(XNU + os.sep):
+                continue
+            if not os.path.lexists(real) or not os.path.exists(p):
+                print(f'remove dangling {os.path.relpath(p, SDK)}')
+                removed += 1
+                if not dry:
+                    os.unlink(p)
+                continue
+            targets[dp][os.path.dirname(real)] += 1
+    for sdk_dir, counter in sorted(targets.items()):
+        # An SDK directory may merge several xnu directories (e.g. i386/ from osfmk/i386 and bsd/i386).
+        for xnu_dir in sorted(counter):
+            for f in sorted(os.listdir(xnu_dir)):
+                if not f.endswith(('.h', '.defs')):
+                    continue
+                src = os.path.join(xnu_dir, f)
+                dst = os.path.join(sdk_dir, f)
+                if os.path.lexists(dst) or os.path.relpath(src, XNU) in old:
+                    continue
+                print(f'add {os.path.relpath(dst, SDK)} -> xnu/{os.path.relpath(src, XNU)}')
+                added += 1
+                if not dry:
+                    os.symlink(os.path.relpath(src, sdk_dir), dst)
+    print(f'{added} added, {removed} removed')
+
+if __name__ == '__main__':
+    main()
