index 0000000..ac51b2e
--- /dev/null
+++ b/darling/include/darling_host_cdefs.h
@@ -0,0 +1,42 @@
+/*
+ * migcom is built for the Linux host, where glibc provides <sys/cdefs.h>. Newer xnu headers
+ * (12377 and later) use these Darwin cdefs macros in userspace sections, so supply the same
+ * fallbacks Darwin uses when the compiler extensions are unavailable.
+ */
+#ifndef DARLING_HOST_CDEFS_H
+#define DARLING_HOST_CDEFS_H
+
+#ifndef __kernel_ptr_semantics
+#define __kernel_ptr_semantics
+#endif
+#ifndef __kernel_data_semantics
+#define __kernel_data_semantics
+#endif
+#ifndef __kernel_dual_semantics
+#define __kernel_dual_semantics
+#endif
+
+#ifndef __enum_open
+#define __enum_open
+#endif
+#ifndef __enum_closed
+#define __enum_closed
+#endif
+#ifndef __enum_options
+#define __enum_options
+#endif
+
+#ifndef __enum_decl
+#define __enum_decl(_name, _type, ...) typedef _type _name; enum __VA_ARGS__ __enum_open
+#endif
+#ifndef __enum_closed_decl
+#define __enum_closed_decl(_name, _type, ...) typedef _type _name; enum __VA_ARGS__ __enum_closed
+#endif
+#ifndef __options_decl
+#define __options_decl(_name, _type, ...) typedef _type _name; enum __VA_ARGS__ __enum_open __enum_options
+#endif
+#ifndef __options_closed_decl
+#define __options_closed_decl(_name, _type, ...) typedef _type _name; enum __VA_ARGS__ __enum_closed __enum_options
+#endif
+
+#endif
