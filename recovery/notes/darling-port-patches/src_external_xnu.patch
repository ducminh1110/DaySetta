+	fx->sw = *((uint16_t*)&s->__fpu_fsw);
+	fx->tag = s->__fpu_ftw;
+	fx->ipoff = s->__fpu_ip;
+	fx->cssel = s->__fpu_cs;
+	fx->dataoff = s->__fpu_dp;
+	fx->datasel = s->__fpu_ds;
+	fx->mxcsr = s->__fpu_mxcsr;
