+
+extern struct elf_calls* _elfcalls;
+
+struct elf_calls* elfcalls(void)
+{
+	if (!_elfcalls)
+	{
+		//void* module = dlopen("/usr/lib/darling/libelfloader.dylib", RTLD_NOW);
+		// if (!module)
+		//	__simple_printf("Load error: %s\n", dlerror());
+
