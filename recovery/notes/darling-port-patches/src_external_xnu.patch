+#define LINUX_GRND_RANDOM 2
+
+long sys_getentropy(void* buf, unsigned long size)
+{
+	int ret;
+
+	ret = LINUX_SYSCALL(__NR_getrandom, buf, size, 0);
+	if (ret < 0)
+		ret = errno_linux_to_bsd(ret);
+
+	if (ret < size)
+		return -EIO;
+
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/gethostuuid.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/gethostuuid.c
