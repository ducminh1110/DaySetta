+	_xtrace_thread_exit();
+
+	// we can also unguard the RPC FD for this thread now
+	guard_table_remove(mach_driver_get_fd());
+
+	return __darling_thread_terminate(stackaddr, freesize, pthread_obj_size);
+#else
+	return bsdthread_terminate_trap((uintptr_t) stackaddr, freesize,
+			port, join_sem);
+#endif
+#else
+	return -ENOSYS;
+#endif
+}
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/bsdthread/disable_threadsignal.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/bsdthread/disable_threadsignal.c
