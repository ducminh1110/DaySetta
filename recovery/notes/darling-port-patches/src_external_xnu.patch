@@ -0,0 +1,18 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/process/task_read_for_pid.h>
+
+#include <sys/errno.h>
+
+#include <darling/emulation/xnu_syscall/mach/impl/mach_traps.h>
+
+// Darling does not distinguish task port flavors, so the read and inspect variants (BSD syscalls
+// that report errors through errno, unlike the task_for_pid trap) hand out the full task port.
+
+long sys_task_read_for_pid(mach_port_name_t target_tport, int pid, mach_port_name_t* t)
+{
+	return task_for_pid_impl(target_tport, pid, t) == KERN_SUCCESS ? 0 : -EPERM;
+}
+
+long sys_task_inspect_for_pid(mach_port_name_t target_tport, int pid, mach_port_name_t* t)
+{
+	return task_for_pid_impl(target_tport, pid, t) == KERN_SUCCESS ? 0 : -EPERM;
+}
