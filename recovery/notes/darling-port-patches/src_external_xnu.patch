+};
+const size_t length_of_translation_array = sizeof(linux_to_darwin)/sizeof(const int);
+
+int errno_linux_to_bsd(int err)
+{
+	int v = err;
+	if (v < 0)
+		v = -v;
+
+	if ((v < length_of_translation_array) && (linux_to_darwin[v]))
+	{
+		v = linux_to_darwin[v];
+		return (err < 0) ? -v : v;
+	}
+
+	return err;
+}
