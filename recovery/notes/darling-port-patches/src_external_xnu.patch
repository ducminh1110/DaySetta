+
+#if defined(__i386__)
+
+PSEUDO_INT(___pipe, pipe, 0)
+	movl	4(%esp),%ecx
+	movl	%eax,(%ecx)
+	movl	%edx,4(%ecx)
+	xorl	%eax,%eax
+	ret
+
+#elif defined(__x86_64__)
+
+PSEUDO(___pipe, pipe, 0, cerror_nocancel)
+	movl	%eax, (%rdi)
+	movl	%edx, 4(%rdi)
+	xorl	%eax, %eax
+	ret
+	UNWIND_EPILOGUE
+
+#elif defined(__arm__)
+
+MI_ENTRY_POINT(___pipe)
+	mov		r3,r0              // save fildes across syscall
+	SYSCALL_NONAME(pipe, 0, cerror_nocancel)
+	str     r0, [r3, #0]
+	str     r1, [r3, #4]
+	mov		r0,#0
+	bx		lr
+
+#elif defined(__arm64__)
+
+MI_ENTRY_POINT(___pipe)
+	mov		x9, x0				// Stash FD array
+	SYSCALL_NONAME(pipe, 0, cerror_nocancel)
+	stp		w0, w1, [x9]		// Save results
+	mov		x0, #0				// Success
+	ret							// Done
+
+#else
+#error Unsupported architecture
+#endif
+#if defined(__arm64__)
+	.globl	_pipe
+	.set	_pipe, ___pipe
+#endif
