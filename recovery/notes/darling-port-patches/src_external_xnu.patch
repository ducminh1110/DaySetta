+
+#ifdef DARLING
+__attribute__((visibility("hidden")))
+int _darling_libkernel_strncmp(const char* str1, const char* str2, size_t max) {
+	while (max > 0) {
+		if (*str1 == '\0') {
+			if (*str2 == '\0')
+				return 0;
+			return -1;
+		}
+		if (*str2 == '\0')
+			return 1;
+		if (*str1 != *str2) {
+			return *str1 - *str2;
+		}
+		++str1;
+		++str2;
+		--max;
+	}
+	return 0;
+};
+#endif
