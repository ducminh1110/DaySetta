diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/task_read_for_pid.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/task_read_for_pid.c
