+			option, send_size, rcv_size,
+			rcv_name, timeout, notify,
+			msg, 0);
+}
+
+mach_msg_return_t mach_msg_overwrite_trap_impl(
+				mach_msg_header_t *msg,
+				mach_msg_option_t option,
+				mach_msg_size_t send_size,
+				mach_msg_size_t rcv_size,
+				mach_port_name_t rcv_name,
+				mach_msg_timeout_t timeout,
+				mach_port_name_t notify,
+				mach_msg_header_t *rcv_msg,
+				mach_msg_size_t rcv_limit)
+{
+	int code;
+
+retry:
+	code = dserver_rpc_mach_msg_overwrite(msg, option, send_size, rcv_size, rcv_name, timeout, notify, rcv_msg);
+
+	if (code < 0) {
+		if (code == -LINUX_EINTR) {
+			// when the RPC call returns EINTR, it means we didn't manage to send the RPC message to the server;
+			// when the RPC receive operation receives EINTR, it retries the call, meaning we should never see EINTR from an RPC receive.
+			// therefore, if we wanted to both send and receive a message, this means the send (which is performed first) was interrupted.
+			//
+			// we also need to check if the caller wants to know about interrupts. if they want send interrupts, we tell them.
+			// if they want receive interrupts, we tell them. otherwise, we retry the call.
+			if ((option & MACH_SEND_MSG) != 0 && (option & MACH_SEND_INTERRUPT) != 0) {
+				return MACH_SEND_INTERRUPTED;
+			} else if ((option & MACH_RCV_MSG) != 0 && (option & MACH_RCV_INTERRUPT) != 0) {
+				return MACH_RCV_INTERRUPTED;
+			} else {
+				goto retry;
+			}
+		}
+		__simple_printf("mach_msg_overwrite failed (internally): %d\n", code);
+		__simple_abort();
+	}
+
+	return code;
+}
+
+/*
+ * mach_msg2_trap ABI, from xnu 12377's <mach/message.h> (PRIVATE there, and this file is not built
+ * with PRIVATE). Each 64-bit argument packs two 32-bit fields, low half first.
+ */
+#define DARLING_MACH64_MSG_VECTOR 0x0000000100000000ull
+
+typedef struct {
+	mach_vm_address_t msgv_data;     /* mach_msg_header_t* or aux header */
+	mach_vm_address_t msgv_rcv_addr; /* receive here instead, if non-zero */
+	mach_msg_size_t msgv_send_size;
+	mach_msg_size_t msgv_rcv_size;
+} darling_mach_msg_vector_t;
+_Static_assert(sizeof(darling_mach_msg_vector_t) == 24, "mach_msg_vector_t layout");
+
+typedef struct {
+	mach_msg_size_t msgdh_size;
+	uint32_t msgdh_reserved;
+} darling_mach_msg_aux_header_t;
+
+#define MSG2_LO(x) ((uint32_t)(x))
+#define MSG2_HI(x) ((uint32_t)((x) >> 32))
+
+/*
+ * Darling's server speaks the mach_msg_overwrite protocol, so translate. The kernel takes the send
+ * header from the registers rather than from memory; write it into the send buffer so the server
+ * sees exactly what the caller passed. Aux data (vector slot 1) is not supported: on receive the
+ * caller gets an empty aux header.
+ */
+mach_msg_return_t mach_msg2_trap_impl(
+				void *data,
+				uint64_t options,
+				uint64_t msgh_bits_and_send_size,
+				uint64_t msgh_remote_and_local_port,
+				uint64_t msgh_voucher_and_id,
+				uint64_t desc_count_and_rcv_name,
+				uint64_t rcv_size_and_priority,
+				uint64_t timeout)
+{
+	mach_msg_option_t option = (mach_msg_option_t)MSG2_LO(options);
+	mach_port_name_t rcv_name = MSG2_HI(desc_count_and_rcv_name);
+	mach_port_name_t notify = MACH_PORT_NULL;
+	darling_mach_msg_aux_header_t *rcv_aux = NULL;
+	mach_msg_header_t *send_msg, *rcv_msg;
+	mach_msg_size_t send_size, rcv_size;
+	mach_msg_return_t mr;
+
+	if (options & DARLING_MACH64_MSG_VECTOR) {
+		/* In vector form the two size arguments are vector counts. */
+		darling_mach_msg_vector_t *vecs = data;
+		mach_msg_size_t send_count = MSG2_HI(msgh_bits_and_send_size);
+		mach_msg_size_t rcv_count = MSG2_LO(rcv_size_and_priority);
+
+		if (vecs == NULL || (send_count == 0 && rcv_count == 0)) {
+			return MACH_SEND_INVALID_DATA;
+		}
+		send_msg = (mach_msg_header_t *)vecs[0].msgv_data;
+		rcv_msg = vecs[0].msgv_rcv_addr ? (mach_msg_header_t *)vecs[0].msgv_rcv_addr : send_msg;
+		send_size = vecs[0].msgv_send_size;
+		rcv_size = vecs[0].msgv_rcv_size;
+		if (rcv_count > 1 && (vecs[1].msgv_data || vecs[1].msgv_rcv_addr) && vecs[1].msgv_rcv_size >= sizeof(*rcv_aux)) {
+			rcv_aux = (darling_mach_msg_aux_header_t *)(vecs[1].msgv_rcv_addr ? vecs[1].msgv_rcv_addr : vecs[1].msgv_data);
+		}
+	} else {
+		send_msg = rcv_msg = data;
+		send_size = MSG2_HI(msgh_bits_and_send_size);
+		rcv_size = MSG2_LO(rcv_size_and_priority);
+	}
+
+	if (option & MACH_SEND_MSG) {
+		send_msg->msgh_bits = MSG2_LO(msgh_bits_and_send_size);
+		send_msg->msgh_size = send_size;
+		send_msg->msgh_remote_port = MSG2_LO(msgh_remote_and_local_port);
+		send_msg->msgh_local_port = MSG2_HI(msgh_remote_and_local_port);
+		send_msg->msgh_voucher_port = MSG2_LO(msgh_voucher_and_id);
+		send_msg->msgh_id = MSG2_HI(msgh_voucher_and_id);
+		/* mach_msg_overwrite passed the send priority (override) in the notify slot. */
+		notify = MSG2_HI(rcv_size_and_priority);
+	} else if ((option & MACH_RCV_MSG) && (option & MACH_RCV_SYNC_WAIT)) {
+		/* ...and the sync-wait port in the header's remote port. */
+		notify = MSG2_LO(msgh_remote_and_local_port);
+	}
+
+	mr = mach_msg_overwrite_trap_impl(send_msg, option, send_size, rcv_size, rcv_name,
+			(mach_msg_timeout_t)timeout, notify, rcv_msg, 0);
+
+	if (rcv_aux != NULL && (option & MACH_RCV_MSG) && mr == MACH_MSG_SUCCESS) {
+		rcv_aux->msgdh_size = 0;
+		rcv_aux->msgdh_reserved = 0;
+	}
+	return mr;
+}
