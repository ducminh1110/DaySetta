index 00000000..bd9cdc2a
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/misc/sysctl_kern.c
@@ -0,0 +1,344 @@
+#include <darling/emulation/xnu_syscall/bsd/helper/misc/sysctl_kern.h>
+
+#include <sys/errno.h>
+
+#include <darling/emulation/xnu_syscall/bsd/helper/misc/sysctl_proc.h>
