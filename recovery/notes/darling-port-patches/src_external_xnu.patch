--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/setlogin.c
@@ -0,0 +1,12 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/misc/setlogin.h>
+
