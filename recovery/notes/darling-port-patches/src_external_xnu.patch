index 00000000..62d9db04
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/bind.c
@@ -0,0 +1,43 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/network/bind.h>
