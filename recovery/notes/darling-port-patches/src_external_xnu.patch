+kern_return_t		mach_wait_until_impl(
+						uint64_t		deadline)
+{
+	struct timespec ts = { deadline / NSEC_PER_SEC, deadline % NSEC_PER_SEC };
+	
+do_sleep:
+	if (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, 0) == -1)
