diff --git a/darling/src/libsystem_kernel/emulation/include/linux_premigration/resources/dserver-rpc-defs.h b/darling/src/libsystem_kernel/emulation/include/linux_premigration/resources/dserver-rpc-defs.h
new file mode 100644
index 00000000..f6588cc5
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/linux_premigration/resources/dserver-rpc-defs.h
@@ -0,0 +1,298 @@
+#include <stddef.h>
+#include <sys/_types/_iovec_t.h>
+
+#include <darling/emulation/xnu_syscall/bsd/impl/network/recvmsg.h>
+#include <darling/emulation/xnu_syscall/bsd/impl/network/sendmsg.h>
+#include <darling/emulation/xnu_syscall/bsd/impl/network/getsockopt.h>
