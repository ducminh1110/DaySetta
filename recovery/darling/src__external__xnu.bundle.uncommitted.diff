diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/connect.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/connect.c
index 4c9a88cf..5df7e191 100644
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/connect.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/connect.c
@@ -37,6 +37,7 @@ long sys_connect_nocancel(int fd, const void* name, int socklen)
 	if (ret < 0)
 		return ret;
 
+#if defined(__aarch64__)
 	// DARLING workaround: Darwin clients on Darling-arm64 often set
 	// O_NONBLOCK on the socket and then wait for connect completion via
 	// Mach kqueue paths that Darling's kqueue plumbing doesn't yet wire
@@ -50,6 +51,7 @@ long sys_connect_nocancel(int fd, const void* name, int socklen)
 	if (was_nonblock) {
 		LINUX_SYSCALL(__NR_fcntl, fd, 4 /*F_SETFL*/, flags & ~0x800L);
 	}
+#endif
 
 #ifdef __NR_socketcall
 	ret = LINUX_SYSCALL(__NR_socketcall, LINUX_SYS_CONNECT, ((long[6]) { fd, fixed, socklen }));
@@ -57,9 +59,11 @@ long sys_connect_nocancel(int fd, const void* name, int socklen)
 	ret = LINUX_SYSCALL(__NR_connect, fd, fixed, socklen);
 #endif
 
+#if defined(__aarch64__)
 	if (was_nonblock) {
 		LINUX_SYSCALL(__NR_fcntl, fd, 4 /*F_SETFL*/, flags);  // restore O_NONBLOCK
 	}
+#endif
 
 	if (ret < 0)
 		ret = errno_linux_to_bsd(ret);
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/socket.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/network/socket.c
